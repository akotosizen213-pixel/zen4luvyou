local function GetCharacter() return LocalPlayer.Character end
local function GetHumanoid()
    local c = GetCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function GetRootPart()
    local c = GetCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function IsSameTeam(player)
    return State.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team
end

local function HasLineOfSight(player)
    if not State.WallCheck then return true end
    local char = player.Character
    if not char then return false end
    local head = char:FindFirstChild("Head")
    if not head then return false end
    local root = GetRootPart()
    if not root then return false end
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {GetCharacter(), char}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(root.Position, (head.Position - root.Position), rayParams)
    return result == nil
end

local function GetClosestPlayer()
    local closest, closestDist = nil, math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if IsSameTeam(p) then continue end
        local char = p.Character
        if not char then continue end
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then continue end
        if not HasLineOfSight(p) then continue end
        local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if dist < State.FOVSize and dist < closestDist then
            closest = p
            closestDist = dist
        end
    end
    return closest
end

-- AIMBOT
local function StartAimbot()
    if Connections["Aimbot"] then Connections["Aimbot"]:Disconnect() end
    Connections["Aimbot"] = RunService.RenderStepped:Connect(function()
        if not State.Aimbot then return end
        local target = GetClosestPlayer()
        if not target or not target.Character then return end
        local head = target.Character:FindFirstChild("Head")
        if not head then return end
        local currentCF = Camera.CFrame
        Camera.CFrame = currentCF:Lerp(CFrame.new(currentCF.Position, head.Position), State.AimbotSmoothing)
    end)
end

-- SILENT AIM
local function StartSilentAim()
    local ok, mt = pcall(getrawmetatable, game)
    if not ok or not mt then return end
    OriginalIndex = mt.__index
    pcall(setreadonly, mt, false)
    mt.__index = newcclosure(function(self, key)
        if key == "Hit" and self == Mouse and State.SilentAim then
            local target = GetClosestPlayer()
            if target and target.Character then
                local head = target.Character:FindFirstChild("Head")
                if head then return CFrame.new(head.Position) end
            end
        end
        return OriginalIndex(self, key)
    end)
    pcall(setreadonly, mt, true)
end

local function StopSilentAim()
    local ok, mt = pcall(getrawmetatable, game)
    if not ok or not mt or not OriginalIndex then return end
    pcall(setreadonly, mt, false)
    mt.__index = OriginalIndex
    pcall(setreadonly, mt, true)
end

-- ESP
local function ClearESP()
    for _, v in pairs(ESPObjects) do pcall(function() v:Destroy() end) end
    ESPObjects = {}
    for k, v in pairs(Connections) do
        if tostring(k):sub(1,4) == "ESP_" then v:Disconnect() Connections[k] = nil end
    end
end

local function CreateESP(player)
    if player == LocalPlayer then return end
    local billboard = Instance.new("BillboardGui")
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0,130,0,45)
    billboard.StudsOffset = Vector3.new(0,3.5,0)
    billboard.ResetOnSpawn = false

    local nameLabel = Instance.new("TextLabel", billboard)
    nameLabel.Size = UDim2.fromScale(1,0.55)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextScaled = true

    local healthLabel = Instance.new("TextLabel", billboard)
    healthLabel.Size = UDim2.fromScale(1,0.45)
    healthLabel.Position = UDim2.fromScale(0,0.55)
    healthLabel.BackgroundTransparency = 1
    healthLabel.TextColor3 = Color3.fromRGB(100,255,100)
    healthLabel.TextStrokeTransparency = 0
    healthLabel.Font = Enum.Font.Gotham
    healthLabel.TextScaled = true

    ESPObjects[player.Name] = billboard

    Connections["ESP_"..player.Name] = RunService.RenderStepped:Connect(function()
        if not State.ESP then billboard.Enabled = false return end
        if IsSameTeam(player) then billboard.Enabled = false return end
        local char = player.Character
        if not char then billboard.Enabled = false return end
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not head or not hum then billboard.Enabled = false return end
        if billboard.Parent ~= head then billboard.Parent = head end
        billboard.Enabled = true
        healthLabel.Text = "HP "..math.floor(hum.Health).."/"..math.floor(hum.MaxHealth)
    end)
end

local function StartESP()
    ClearESP()
    for _, p in ipairs(Players:GetPlayers()) do CreateESP(p) end
    Players.PlayerAdded:Connect(function(p)
        task.wait(1)
        if State.ESP then CreateESP(p) end
    end)
end

-- BIG HEAD
local function ApplyBigHead()
    local char = GetCharacter()
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    if State.BigHead then
        head.Size = Vector3.new(State.BigHeadSize, State.BigHeadSize, State.BigHeadSize)
    else
        head.Size = Vector3.new(2,1,1)
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if State.BigHead then ApplyBigHead() end
end)

-- NOCLIP
local function StartNoclip()
    if Connections["Noclip"] then Connections["Noclip"]:Disconnect() end
    Connections["Noclip"] = RunService.Stepped:Connect(function()
        if not State.Noclip then return end
        local char = GetCharacter()
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

